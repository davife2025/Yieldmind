{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "CommonJS",
    "moduleResolution": "node",
    "outDir":           "./dist",
    "rootDir":          "./src",
    "strict":           true,
    "esModuleInterop":  true,
    "paths": {
      "@yieldmind/db":     ["../../packages/db/index.ts"],
      "@yieldmind/shared": ["../../packages/shared/index.ts"],
      "@yieldmind/agent":  ["../../packages/agent/src/index.ts"],
      "@yieldmind/agent/*": ["../../packages/agent/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
