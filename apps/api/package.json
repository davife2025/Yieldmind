{
  "name": "@yieldmind/api",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "dev":        "tsx watch src/index.ts",
    "start":      "tsx src/index.ts",
    "build":      "tsc --outDir dist",
    "start:prod": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@yieldmind/agent":  "workspace:*",
    "@yieldmind/db":     "workspace:*",
    "@yieldmind/shared": "workspace:*",
    "express":           "^4.19.2",
    "cors":              "^2.8.5",
    "helmet":            "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "dotenv":            "^16.4.5",
    "node-cron":         "^3.0.3",
    "zod":               "^3.23.8"
  },
  "devDependencies": {
    "@types/express":    "^4.17.21",
    "@types/cors":       "^2.8.17",
    "@types/node":       "^20.14.2",
    "@types/node-cron":  "^3.0.11",
    "tsx":               "^4.15.5",
    "typescript":        "^5.4.5"
  }
}
